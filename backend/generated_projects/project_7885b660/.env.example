# Example .env file for local development
# Database URL for SQLAlchemy. For SQLite, specify a path.
# For other databases (PostgreSQL, MySQL), use their respective connection strings.
DATABASE_URL="sqlite+aiosqlite:///./task_manager.db"

# Project name and API version can also be configured here if desired
# PROJECT_NAME="My Task Manager"
# API_VERSION="2.0.0"
